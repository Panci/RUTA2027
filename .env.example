# -------------------------------------------------------------
# RUTA 2027 - VARIABLES DE ENTORNO
# -------------------------------------------------------------

# Entorno de ejecución (development, test, staging, production)
NODE_ENV=production

# Base de datos PostgreSQL
# En local con PostgreSQL propio: postgresql://postgres:postgres@localhost:5432/ruta2027?schema=public
# En Dokploy con contenedor interno: postgresql://ruta2027_admin:SuperSecurePassword2027!@postgres:5432/ruta2027_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ruta2027?schema=public"

# Credenciales de PostgreSQL para Dokploy / Docker Compose
POSTGRES_USER=ruta2027_admin
POSTGRES_PASSWORD=GenerarUnaPasswordSeguraAqui!2027
POSTGRES_DB=ruta2027_db

# Dominio y puertos para Dokploy (Hostinger VPS)
APP_DOMAIN=campana.tudominio.es
APP_PORT=3000

# Seguridad de Autenticación (generar con `openssl rand -base64 32`)
NEXTAUTH_SECRET=sustituir_por_un_secreto_aleatorio_de_32_caracteres_o_mas
NEXTAUTH_URL=https://campana.tudominio.es

# Configuración de Copias de Seguridad
BACKUP_KEEP_DAYS=14
